     fhir:display [ fhir:v "fast vårdkontakt" ] ;
     fhir:definition [ fhir:v "namngiven personal inom hälso- och sjukvård som ska bistå och stödja patienten genom att samordna vårdens insatser och övriga kontakter" ]
  ] [
     fhir:code [ fhir:v "2" ] ;
     fhir:display [ fhir:v "fast läkarkontakt i primärvård" ] ;
     fhir:definition [ fhir:v "namngiven läkare på den hälso- eller vårdcentral där patienten är listad, som ansvarar för och samordnar patientens medicinska vård" ]
  ] [
