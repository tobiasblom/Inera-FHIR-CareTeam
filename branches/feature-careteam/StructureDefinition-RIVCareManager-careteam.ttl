     ] [
       fhir:id [ fhir:v "CareTeam.managingOrganization" ] ;
       fhir:path [ fhir:v "CareTeam.managingOrganization" ] ;
       fhir:short [ fhir:v "Ansvarig organisation" ] ;
       fhir:definition [ fhir:v "Används inte för fast kontakt. Den enhet där den fasta kontakten tjänstgör anges i den refererade PractitionerRole." ]
     ] [
       fhir:id [ fhir:v "CareTeam.telecom" ] ;
       fhir:path [ fhir:v "CareTeam.telecom" ] ;
       fhir:short [ fhir:v "Kontaktväg till den fasta kontakten" ] ;
       fhir:definition [ fhir:v "Kontaktväg som invånaren använder för att nå den fasta kontakten, till exempel ett telefonnummer eller en webbadress. Om den fasta kontakten nås via ett team kan teamet i stället anges i participant.extension[contactViaTeam], och kontaktvägen hämtas då från teamets telecom." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "CareTeam.telecom.extension:availability" ] ;
       fhir:path [ fhir:v "CareTeam.telecom.extension" ] ;
       fhir:sliceName [ fhir:v "availability" ] ;
       fhir:short [ fhir:v "Kontakttider" ] ;
       fhir:definition [ fhir:v "Anger veckodagar och tider då kontaktvägen är tillgänglig, till exempel telefontider." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Extension"^^xsd:anyURI ] ;
         fhir:profile ( [
           fhir:v "https://fhir.inera.se/ig/careteam/StructureDefinition/RIVContactPointAvailability"^^xsd:anyURI ;
           fhir:link <https://fhir.inera.se/ig/careteam/StructureDefinition/RIVContactPointAvailability>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "CareTeam.telecom.extension:availability.value[x].availableTime.daysOfWeek" ] ;
       fhir:path [ fhir:v "CareTeam.telecom.extension.value[x].availableTime.daysOfWeek" ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "RIVCareManager-to-fast-kontakt-im" ] ;
         fhir:map [ fhir:v "Kontakttid.veckodag" ] ;
         fhir:comment [ fhir:v "Veckodag då kontaktvägen är tillgänglig." ]
       ] )
     ] [
       fhir:id [ fhir:v "CareTeam.telecom.extension:availability.value[x].availableTime.availableStartTime" ] ;
       fhir:path [ fhir:v "CareTeam.telecom.extension.value[x].availableTime.availableStartTime" ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "RIVCareManager-to-fast-kontakt-im" ] ;
         fhir:map [ fhir:v "Kontakttid.starttid" ] ;
         fhir:comment [ fhir:v "Tidpunkt då kontakttiden börjar." ]
       ] )
     ] [
       fhir:id [ fhir:v "CareTeam.telecom.extension:availability.value[x].availableTime.availableEndTime" ] ;
       fhir:path [ fhir:v "CareTeam.telecom.extension.value[x].availableTime.availableEndTime" ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "RIVCareManager-to-fast-kontakt-im" ] ;
         fhir:map [ fhir:v "Kontakttid.sluttid" ] ;
         fhir:comment [ fhir:v "Tidpunkt då kontakttiden slutar." ]
       ] )
     ] [
       fhir:id [ fhir:v "CareTeam.telecom.system" ] ;
       fhir:path [ fhir:v "CareTeam.telecom.system" ] ;
       fhir:short [ fhir:v "Typ av kontaktväg" ] ;
       fhir:definition [ fhir:v "Anger vilken sorts kontaktväg det är, till exempel telefon, e-post eller webbadress." ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "RIVCareManager-to-fast-kontakt-im" ] ;
         fhir:map [ fhir:v "Kontaktväg.kontaktvägstyp" ] ;
         fhir:comment [ fhir:v "Typ av kontaktväg, exempelvis telefon, e-post eller webbadress." ]
       ] )
     ] [
       fhir:id [ fhir:v "CareTeam.telecom.value" ] ;
       fhir:path [ fhir:v "CareTeam.telecom.value" ] ;
       fhir:short [ fhir:v "Kontaktuppgift" ] ;
       fhir:definition [ fhir:v "Själva kontaktuppgiften, till exempel ett telefonnummer eller en webbadress, i den form den ska visas för invånaren." ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "RIVCareManager-to-fast-kontakt-im" ] ;
         fhir:map [ fhir:v "Kontaktväg.värde" ] ;
         fhir:comment [ fhir:v "Värdet för kontaktvägen, exempelvis telefonnummer, e-postadress eller URL." ]
       ] )
     ] [
       fhir:id [ fhir:v "CareTeam.telecom.use" ] ;
       fhir:path [ fhir:v "CareTeam.telecom.use" ] ;
       fhir:short [ fhir:v "Avsedd användning" ] ;
       fhir:definition [ fhir:v "Anger avsedd användning av kontaktvägen." ]
     ] [
       fhir:id [ fhir:v "CareTeam.telecom.rank" ] ;
       fhir:path [ fhir:v "CareTeam.telecom.rank" ] ;
       fhir:short [ fhir:v "Prioritetsordning" ] ;
       fhir:definition [ fhir:v "Ordning i vilken kontaktvägarna bör användas. Värdet 1 anger högst prioritet." ]
     ] [
       fhir:id [ fhir:v "CareTeam.telecom.period" ] ;
       fhir:path [ fhir:v "CareTeam.telecom.period" ] ;
       fhir:short [ fhir:v "Giltighetsperiod för kontaktvägen" ] ;
       fhir:definition [ fhir:v "Period under vilken kontaktvägen gäller." ]
     ] [
       fhir:id [ fhir:v "CareTeam.note" ] ;
       fhir:path [ fhir:v "CareTeam.note" ] ;
       fhir:short [ fhir:v "Kommentar" ] ;
       fhir:definition [ fhir:v "Kommentar i fritext om den fasta kontakten, till exempel vägledning om när och hur invånaren kan ta kontakt." ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "RIVCareManager-to-fast-kontakt-im" ] ;
         fhir:map [ fhir:v "Fast kontakt.kommentar" ] ;
         fhir:comment [ fhir:v "Kommentar eller vägledning i fritext kring den fasta kontakten. Förutsätter att note används i profilen." ]
       ] )
     ] )
  ] . # 

