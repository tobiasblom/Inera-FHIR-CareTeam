       fhir:definition [ fhir:v "Anger vilken typ av fast kontakt relationen avser, till exempel fast vårdkontakt, fast läkarkontakt i primärvården eller fast omsorgskontakt i hemtjänsten. Rollen avser funktionen i relation till invånaren, inte yrkestitel eller befattning." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
