  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "CareTeam" ] ;
       fhir:path [ fhir:v "CareTeam" ] ;
       fhir:short [ fhir:v "Fast kontakt" ] ;
       fhir:definition [ fhir:v "Relationen mellan en invånare och en namngiven vård- eller omsorgspersonal som tilldelats en samordnande roll för invånaren i syfte att skapa trygghet och kontinuitet. Varje resurs beskriver en fast kontakt. En invånare med flera fasta kontakter har därför flera resurser." ]
     ] [
       fhir:id [ fhir:v "CareTeam.id" ] ;
       fhir:path [ fhir:v "CareTeam.id" ] ;
       fhir:short [ fhir:v "Resursens logiska id" ] ;
       fhir:definition [ fhir:v "Logiskt id som tilldelas av den server som lagrar resursen. Id:t ändras inte under resursens livstid." ]
     ] [
       fhir:id [ fhir:v "CareTeam.meta" ] ;
       fhir:path [ fhir:v "CareTeam.meta" ] ;
       fhir:short [ fhir:v "Metadata om resursen" ] ;
       fhir:definition [ fhir:v "Metadata som hanteras av infrastrukturen, till exempel versions-id och tidpunkt för senaste ändring." ]
     ] [
       fhir:id [ fhir:v "CareTeam.implicitRules" ] ;
       fhir:path [ fhir:v "CareTeam.implicitRules" ] ;
       fhir:short [ fhir:v "Regler som innehållet skapats enligt" ] ;
       fhir:definition [ fhir:v "Referens till regler som följdes när resursen skapades och som mottagaren måste känna till för att tolka innehållet. Förväntas inte användas." ]
     ] [
       fhir:id [ fhir:v "CareTeam.language" ] ;
       fhir:path [ fhir:v "CareTeam.language" ] ;
       fhir:short [ fhir:v "Språk för resursens innehåll" ] ;
       fhir:definition [ fhir:v "Det språk som resursens textinnehåll är skrivet på." ]
     ] [
       fhir:id [ fhir:v "CareTeam.text" ] ;
       fhir:path [ fhir:v "CareTeam.text" ] ;
       fhir:short [ fhir:v "Läsbar sammanfattning" ] ;
       fhir:definition [ fhir:v "Sammanfattning av resursens innehåll i läsbar form, avsedd för visning för människor." ]
     ] [
       fhir:id [ fhir:v "CareTeam.contained" ] ;
       fhir:path [ fhir:v "CareTeam.contained" ] ;
       fhir:short [ fhir:v "Inbäddade resurser" ] ;
       fhir:definition [ fhir:v "Resurser som ingår i denna resurs och saknar egen identitet utanför den. Bör undvikas när de refererade resurserna kan hämtas separat." ]
     ] [
       fhir:id [ fhir:v "CareTeam.extension" ] ;
       fhir:path [ fhir:v "CareTeam.extension" ] ;
       fhir:short [ fhir:v "Tillägg" ] ;
       fhir:definition [ fhir:v "Ytterligare information som inte ingår i basresursen, uttryckt med extensioner." ]
     ] [
       fhir:id [ fhir:v "CareTeam.modifierExtension" ] ;
       fhir:path [ fhir:v "CareTeam.modifierExtension" ] ;
       fhir:short [ fhir:v "Tillägg som ändrar tolkningen" ] ;
       fhir:definition [ fhir:v "Extensioner som ändrar betydelsen av resursen eller av element i den. Mottagaren får inte ignorera dem. Förväntas inte användas." ]
     ] [
       fhir:id [ fhir:v "CareTeam.identifier" ] ;
       fhir:path [ fhir:v "CareTeam.identifier" ] ;
       fhir:short [ fhir:v "Identifierare för relationen" ] ;
       fhir:definition [ fhir:v "Identifierare som källsystemet använder för relationen fast kontakt. Ingår inte i informationsmodellen." ]
     ] [
       fhir:id [ fhir:v "CareTeam.status" ] ;
       fhir:path [ fhir:v "CareTeam.status" ] ;
       fhir:definition [ fhir:v "Anger relationens status: active betyder att den fasta kontakten gäller, inactive att relationen har avslutats, suspended att den tillfälligt inte gäller, proposed att den är föreslagen men inte fastställd och entered-in-error att resursen har registrerats felaktigt och inte ska användas." ] ;
       fhir:binding [
         fhir:extension ( [
           fhir:url [ fhir:v "http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName"^^xsd:anyURI ] ;
           fhir:value [
             a fhir:string ;
             fhir:v "CareTeamStatus"
           ]
         ] ) ;
         fhir:strength [ fhir:v "required" ] ;
         fhir:description [ fhir:v "Status för relationen fast kontakt." ] ;
         fhir:valueSet [
           fhir:v "http://hl7.org/fhir/ValueSet/care-team-status|5.0.0"^^xsd:anyURI ;
           fhir:link <http://hl7.org/fhir/ValueSet/care-team-status|5.0.0>
         ]
       ]
     ] [
       fhir:id [ fhir:v "CareTeam.category" ] ;
       fhir:path [ fhir:v "CareTeam.category" ] ;
       fhir:short [ fhir:v "Kategori: fast kontakt" ] ;
       fhir:definition [ fhir:v "Anger att resursen beskriver en fast kontakt och skiljer den från andra användningar av CareTeam, till exempel team. Värdet är fast och är alltid koden fast-kontakt." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
