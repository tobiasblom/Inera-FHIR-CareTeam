       fhir:path [ fhir:v "CareTeam.subject" ] ;
       fhir:short [ fhir:v "Invånare" ] ;
       fhir:definition [ fhir:v "Den invånare som har tilldelats den fasta kontakten. Avser patient inom hälso- och sjukvård eller brukare inom omsorg." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:type ( [
